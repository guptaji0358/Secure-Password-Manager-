/* Nightfall Vault — bespoke PySide6 application theme */

QMainWindow {
    background: #111225;
}

QWidget {
    color: #f3f0ff;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 14px;
}

QLabel#title {
    color: #fdfbff;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QLabel#subtitle {
    color: #aeb0cb;
    font-size: 14px;
}

QFrame#card {
    background: #1b1d38;
    border: 1px solid #35375f;
    border-radius: 18px;
}

QLineEdit {
    background: #14162b;
    border: 1px solid #41436f;
    border-radius: 10px;
    color: #f8f7ff;
    min-height: 30px;
    padding: 6px 11px;
    selection-background-color: #775cf0;
}

QLineEdit:hover {
    border-color: #686aa0;
}

QLineEdit:focus {
    border: 2px solid #a78bfa;
    background: #191b35;
}

QPushButton {
    background: #2b2e50;
    border: 1px solid #464978;
    border-radius: 10px;
    color: #f7f5ff;
    font-weight: 600;
    min-height: 34px;
    padding: 5px 16px;
}

QPushButton:hover {
    background: #3a3d68;
    border-color: #7477af;
}

QPushButton:pressed {
    background: #232542;
}

QPushButton[iconOnly="true"] {
    min-width: 42px;
    max-width: 42px;
    padding: 5px;
}

QPushButton#primaryButton {
    background: #7657e7;
    border-color: #a98fff;
    color: #ffffff;
}

QPushButton#primaryButton:hover {
    background: #8b6cf1;
}

QPushButton#dangerButton {
    background: #552448;
    border-color: #aa4b83;
}

QPushButton#dangerButton:hover {
    background: #71305e;
}

QCheckBox {
    color: #cbc9e5;
    spacing: 9px;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border: 1px solid #5a5d91;
    border-radius: 5px;
    background: #14162b;
}

QCheckBox::indicator:checked {
    background: #f0b45c;
    border-color: #ffd392;
}

QTabWidget::pane {
    border: 1px solid #35375f;
    border-radius: 14px;
    top: -1px;
    background: #181a31;
}

QTabBar::tab {
    background: #202242;
    border: 1px solid #35375f;
    border-bottom: none;
    border-radius: 10px 10px 0 0;
    color: #aaaeca;
    font-weight: 600;
    min-width: 130px;
    padding: 10px 18px;
    margin-right: 5px;
}

QTabBar::tab:hover {
    color: #ebe8ff;
    background: #2b2e50;
}

QTabBar::tab:selected {
    background: #181a31;
    border-top: 3px solid #f0b45c;
    color: #fff7e9;
}

QFrame#credentialCard {
    background: #1b1d38;
    border: 1px solid #363963;
    border-radius: 14px;
}

QFrame#credentialCard:hover {
    background: #202344;
    border-color: #8069e5;
}

QScrollArea,
QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QLabel#credentialSite {
    color: #fff7e9;
    font-size: 17px;
    font-weight: 700;
}

QLabel#credentialDetail {
    color: #aaaeca;
}

QLabel#credentialPassword {
    color: #f5d2a1;
    font-family: "Cascadia Code", "Consolas", monospace;
}

QScrollBar:vertical {
    background: #181a31;
    width: 10px;
    margin: 8px 0;
}

QScrollBar::handle:vertical {
    background: #4d4f7c;
    border-radius: 5px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background: #6d70a7;
}

QMessageBox {
    background: #1b1d38;
}
